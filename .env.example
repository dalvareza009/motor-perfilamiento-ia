# --- Uso local conectado a Vercel (recomendado para scrapear) ---
# Copia este archivo a .env y pega los valores desde Vercel → Environment Variables.
# DATABASE_URL: usa DATABASE_URL_UNPOOLED de Neon.
DATABASE_URL=
DEMO_CLAVE=jefe-prueba-2026
SESION_SECRETA=jefe-prueba-2026
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# --- Solo si NO usas Vercel/Neon (todo en el PC) ---
# Comenta DATABASE_URL arriba y descomenta esto:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=base_datos
# DB_USER=postgres
# DB_PASSWORD=postgres
# OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_EMBED_URL=http://localhost:11434/api/embed
# EMBED_MODEL=nomic-embed-text
